<header class="sheet-header">
  <div class="charname">
    {{#if editable}}
      {{formInput fields.name value=actor.name placeholder=(localize "Name")}}
    {{else}}
      {{actor.name}}
    {{/if}}
  </div>
  <div class="portrait">
    <img
      src="{{actor.img}}"
      class="portrait"
      data-edit="img"
      data-action="editImage"
      title="{{actor.name}}"
    >
  </div>
  <div class="hp box">
    <label for="{{rootId}}-system.health.value">{{
        localize "HELLPIERCERS.ACTOR.FIELDS.health.label"
      }}</label>
    <div class="form-fields flexrow">
      <div class="value">
        {{
          formInput
        systemFields.health.fields.value
        value=system.health.value
        max=system.health.max
        id=(concat rootId "-system.health.value")
        }}
      </div>
      <div class="max">{{system.health.max}}</div>
    </div>
  </div>
  <div class="speed box">
    <label>{{localize "HELLPIERCERS.ACTOR.FIELDS.speed.label"}}</label>
    <div class="form-fields bare flexrow">{{system.speed}}</div>
  </div>
  <div class="scale box">
    <label>{{localize "HELLPIERCERS.ACTOR.FIELDS.scale.label"}}</label>
    <div class="form-fields bare flexrow">{{system.scale}}</div>
  </div>
  <div class="form-group box chartags">
    <label class="flexrow">
      <span>{{localize "HELLPIERCERS.ACTOR.FIELDS.tags.label"}}</span>
      {{#if editable}}
        <a
          class="control"
          role="button"
          aria-label='{{localize "HELLPIERCERS.ACTOR.SHEET.actions.editTags"}}'
          data-tooltip
          data-action="editTags"
        >
          <i class="fa-solid fa-edit"></i>
        </a>
      {{/if}}
    </label>
    <div class="form-fields">
      {{
        formInput systemFields.tags value=system.tags disabled=true rootId=rootId
      }}
    </div>
  </div>
</header>
