<section
  class="tab effects scrollable {{tab.cssClass}}"
  data-group="primary"
  data-tab="effects"
>
  <ol>
    <li class="flexrow header">
      {{localize "HELLPIERCERS.ACTOR.SHEET.effects.active"}}
    </li>
    {{#each effects as |effect|}}
      <li class="effect flexrow" data-effect-id="{{effect.id}}">
        {{#if effect.img}}<img
            src="{{effect.img}}"
            height="20"
            width="20"
          >{{/if}}
        <span class="name">
          {{effect.name}}{{#if effect.flags.hellpiercers.value}}:{{
              effect.flags.hellpiercers.value
            }}{{/if}}
        </span>
        <input
          type="checkbox"
          data-action=""
          data-tooltip="EFFECT.Disabled"
          {{checked effect.disabled}}
          {{disabled (not @root.editable)}}
        >
        <a class="control context-menu" data-context="effect"><i
            class="fas fa-bars"
          ></i></a>
      </li>
    {{else}}
      <li class="flexrow empty">
        {{localize "HELLPIERCERS.ITEM.SHEET.missing.effects"}}
      </li>
    {{/each}}
    {{#if editable}}
      <li class="new-effect">
        <button type="button" data-action="createEffect">
          <i class="fas fa-plus"></i>&nbsp;New Effect
        </button>
      </li>
    {{/if}}
  </ol>
</section>
