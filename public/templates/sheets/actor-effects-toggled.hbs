<section
  class="tab effects {{tab.cssClass}} scrollable"
  data-group="primary"
  data-tab="effects"
>
  {{#if (gt effects.temporary.length 0)}}
    <ol class="temporary">
      <li class="flexrow header">
        {{localize "HELLPIERCERS.ACTOR.SHEET.effects.temporary"}}
      </li>
      {{> "effectList" effects.temporary}}
    </ol>
  {{/if}}
  {{#if (gt effects.items.length 0)}}
    <ol>
      <li class="flexrow header">
        {{localize "HELLPIERCERS.ACTOR.SHEET.effects.item"}}
      </li>
      {{> "effectList" effects.items}}
    </ol>
  {{/if}}
  <ol>
    <li class="flexrow header">
      {{localize "HELLPIERCERS.ACTOR.SHEET.effects.active"}}
    </li>
    {{> "effectList" effects.effects}}
    {{#if editable}}
      <li class="new-effect">
        <button
          type="button"
          data-action="createEffect"
          data-embed-type="ActiveEffect"
        >
          <i class="fas fa-plus"></i>&nbsp;New Effect
        </button>
      </li>
    {{/if}}
  </ol>
</section>

{{#*inline "effectList"}}
  {{#each this}}
    <li
      class="effect flexrow"
      data-effect-id="{{effect.id}}"
      data-effect-uuid="{{uuid}}"
    >
      <img src="{{effect.img}}" height="20" width="20">
      <span class="name">
        {{effect.name}}{{#if effect.system.stacks~}}
          :{{effect.system.stacks}}
        {{~/if}}
      </span>
      {{#if link}}<span>{{{link}}}</span>{{/if}}
      {{#unless effect.isTemporary}}
        <a class="flat" data-action="toggleEffect">
          <i
            class='fa-regular {{ifThen effect.disabled "fa-circle" "fa-circle-check"}}'
          ></i>
        </a>
      {{/unless}}
      <a class="control context-menu" data-context><i
          class="fa-solid fa-bars"
        ></i></a>
    </li>
  {{/each}}
{{/inline}}
