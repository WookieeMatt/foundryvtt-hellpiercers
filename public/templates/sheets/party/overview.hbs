<section
  class="tab overview {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  {{!-- Mission --}}
  <div class="panel mission">
    <h3>{{localize 'HELLPIERCERS.UI.party_overview.mission'}}</h3>
    {{#if mission.active}}
      <ul class="objectives">
        {{#each mission.objectives}}
          <li data-objective="{{key}}" class="{{#if done}}done{{/if}}">
            <a data-action="toggleObjective">
              <i
                class="fa-solid {{#if done}}fa-square-check{{else}}fa-square{{/if}}"
              ></i>
              {{label}}
            </a>
            <span class="reward">{{reward}}</span>
          </li>
        {{/each}}
      </ul>
      <p>
        {{#if mission.factionName}}{{
            localize 'HELLPIERCERS.UI.party_overview.target'
          }} <b>{{mission.factionName}}</b>
          &middot;
        {{/if}}
        {{localize 'HELLPIERCERS.UI.party_overview.defeated'}}
        <b>{{mission.defeats}}</b> &middot; {{
          localize 'HELLPIERCERS.UI.party_overview.rewards_so_far'
        }}
        <b>{{mission.rewards}}</b>
      </p>
      <div class="buttons">
        <button type="button" data-action="finishMission" data-success="true">
          <i class="fa-solid fa-flag-checkered"></i> {{
            localize 'HELLPIERCERS.UI.party_overview.return_to_dis'
          }}
        </button>
        <button type="button" data-action="finishMission" data-success="false">
          <i class="fa-solid fa-flag"></i> {{
            localize 'HELLPIERCERS.UI.party_overview.abandon'
          }}
        </button>
      </div>
    {{else}}
      <div class="mission-planner">
        <ul class="objectives">
          {{#each mission.choices}}
            <li>
              <label>
                <input type="checkbox" name="objective" value="{{key}}">
                {{label}}{{#if special}}
                  <em>{{
                      localize 'HELLPIERCERS.UI.party_overview.special'
                    }}</em>{{/if}}
              </label>
              <span class="reward">{{reward}}</span>
            </li>
          {{/each}}
        </ul>
        <div class="form-group">
          <label>{{
              localize 'HELLPIERCERS.UI.party_overview.target_faction'
            }}</label>
          <select name="faction">
            <option value="">
              {{localize 'HELLPIERCERS.UI.party_overview.none'}}
            </option>
            {{#each mission.factions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>
                {{name}}
              </option>
            {{/each}}
          </select>
        </div>
        <button type="button" data-action="startMission">
          <i class="fa-solid fa-person-walking-arrow-right"></i> {{
            localize 'HELLPIERCERS.UI.party_overview.leave_dis'
          }}
        </button>
      </div>
    {{/if}}
  </div>

  {{!-- Squad --}}
  <div class="panel squad">
    <h3>
      {{localize 'HELLPIERCERS.UI.party_overview.squad'}} <small>(drop a
        HELLPIERCER here)</small>
    </h3>
    {{#if members.length}}
      <ul class="members">
        {{#each members}}
          <li data-member-id="{{id}}">
            <img src="{{img}}" alt="">
            <a data-action="openMember"><b>{{name}}</b></a>
            <span>{{className}}{{#if armorName}}
                &middot; {{armorName}}{{/if}}</span>
            {{#if @root.hasTriumph}}
              <select
                data-triumph-for="{{id}}"
                data-tooltip="{{localize 'HELLPIERCERS.UI.party_overview.triumph'}}"
              >
                <option value="">
                  {{localize 'HELLPIERCERS.UI.party_overview.no_triumph'}}
                </option>
                {{#each @root.triumphs}}
                  <option
                    value="{{key}}"
                    {{#if (eq key ../triumph)}}selected{{/if}}
                  >
                    {{name}}
                  </option>
                {{/each}}
              </select>
            {{/if}}
            <span class="hp">{{hp}}/{{hpMax}}</span>
            <a
              data-action="removeMember"
              data-tooltip="{{localize 'HELLPIERCERS.UI.party_overview.remove'}}"
            ><i class="fa-solid fa-xmark"></i></a>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="hint">
        {{localize 'HELLPIERCERS.UI.party_overview.no_squad_members_yet'}}
      </p>
    {{/if}}
  </div>

  {{#if hasOffGrid}}
    <div class="panel off-grid">
      <h3>
        {{localize 'HELLPIERCERS.UI.party_overview.off_grid_munitions_support'}}
      </h3>
      <select name="system.offGrid">
        <option value="">
          {{localize 'HELLPIERCERS.UI.party_overview.none_selected'}}
        </option>
        {{#each offGrid}}
          <option value="{{name}}" {{#if selected}}selected{{/if}}>
            {{name}}
          </option>
        {{/each}}
      </select>
      <label class="checkbox">
        <input
          type="checkbox"
          name="system.offGridUsed"
          {{#if system.offGridUsed}}checked{{/if}}
        >
        {{localize 'HELLPIERCERS.UI.party_overview.used_this_expedition'}}
      </label>
      {{#if offGridExtra}}<span class="hint">+{{offGridExtra}}
          {{
            localize 'HELLPIERCERS.UI.party_overview.extra_use_triumph'
          }}</span>{{/if}}
    </div>
  {{/if}}

  {{#if hasGrid}}
    <div class="panel grid-suite">
      <h3>
        {{
          localize 'HELLPIERCERS.UI.party_overview.pre_battle_grid_manipulation'
        }}
      </h3>
      <select name="system.gridSuite">
        <option value="">
          {{localize 'HELLPIERCERS.UI.party_overview.none_selected'}}
        </option>
        {{#each gridSuites}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>
            {{name}} - {{tiles}}
          </option>
        {{/each}}
      </select>
      {{#if isGM}}
        <button type="button" data-action="placeSuite">
          <i class="fa-solid fa-chess-board"></i>
          {{localize 'HELLPIERCERS.UI.party_overview.place_suite'}}
        </button>
      {{/if}}
    </div>
  {{/if}}

  {{#if hasLegendary}}
    <div class="panel legendary">
      <h3>
        {{localize 'HELLPIERCERS.UI.party_overview.legendary_arms'}}
        <a
          data-action="addArm"
          data-tooltip="{{localize 'HELLPIERCERS.UI.party_overview.add'}}"
        ><i class="fa-solid fa-plus"></i></a>
        <a
          data-action="endSession"
          data-tooltip="{{localize 'HELLPIERCERS.UI.party_overview.end_session_aion_1'}}"
        ><i class="fa-solid fa-hourglass-half"></i></a>
      </h3>
      <ul>
        {{#each arms}}
          <li data-arm-index="{{index}}">
            <b>{{name}}</b>
            <input
              type="number"
              data-array="arm"
              data-index="{{index}}"
              data-field="aion"
              value="{{aion}}"
              min="0"
            >
            {{localize 'HELLPIERCERS.UI.party_overview.aion'}}
            <a data-action="removeArm"><i class="fa-solid fa-trash"></i></a>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  {{#if hasRoles}}
    <div class="panel roles">
      <h3>{{localize 'HELLPIERCERS.UI.party_overview.roles'}}</h3>
      {{#each roles}}
        <div class="form-group">
          <label>{{label}}</label>
          <select name="system.roles.{{key}}">
            <option value="">
              {{localize 'HELLPIERCERS.UI.party_overview.unassigned'}}
            </option>
            {{#each members}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>
                {{name}}
              </option>
            {{/each}}
          </select>
          <ul class="role-actions">
            {{#each actions}}
              <li data-tooltip="{{text}}">
                <a
                  data-action="useRoleAction"
                  data-role="{{../key}}"
                  data-role-action="{{id}}"
                >
                  <i class="fa-solid fa-bolt"></i> {{name}}
                </a>
                <em>{{phase}}{{#if cost}} &middot; {{cost}}{{/if}}</em>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if hasMastery}}
    <div class="panel mastery">
      <h3>{{localize 'HELLPIERCERS.UI.party_overview.class_mastery'}}</h3>
      <ul>
        {{#each mastery}}
          <li>
            <b>{{name}}</b>: {{
              localize 'HELLPIERCERS.UI.party_overview.missions_progress' missions=missions
            }}
            {{#if mastered}}<i class="fa-solid fa-star"></i> {{
                localize 'HELLPIERCERS.UI.party_overview.mastered'
              }}{{/if}}
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}
</section>
