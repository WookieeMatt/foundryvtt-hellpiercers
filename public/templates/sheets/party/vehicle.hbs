<section
  class="tab vehicle {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  {{#if hasVehicle}}
    <div class="panel">
      <input
        type="text"
        name="system.vehicle.name"
        value="{{system.vehicle.name}}"
        placeholder="{{localize 'HELLPIERCERS.UI.party_vehicle.name_your_vehicle'}}"
      >
      <div class="readiness">
        {{#each readiness}}
          <button
            type="button"
            class="{{#if current}}active{{/if}}"
            data-action="setReadiness"
            data-readiness="{{key}}"
          >
            {{label}}
          </button>
        {{/each}}
      </div>
    </div>
    <div class="panel">
      <h3>
        {{localize 'HELLPIERCERS.UI.party_vehicle.upgrades'}}
        <small>(two active at a time)</small>
        {{localize 'HELLPIERCERS.UI.party_vehicle.and_personalization'}}
      </h3>
      <ul class="vehicle-options">
        {{#each vehicleOptions}}
          <li
            data-option-id="{{id}}"
            class="{{kind}} {{#if installed}}installed{{/if}}"
          >
            <b>{{name}}</b>
            <em>{{kind}}</em>
            <span class="cost">{{cost}}</span>
            {{#if owned}}
              <button type="button" data-action="toggleVehicleOption">
                {{#if installed}}{{
                    localize 'HELLPIERCERS.UI.party_vehicle.remove'
                  }}{{else}}{{
                    localize 'HELLPIERCERS.UI.party_vehicle.install'
                  }}{{/if}}
              </button>
            {{else}}
              <button
                type="button"
                data-action="buyVehicleOption"
                {{#if locked}}disabled{{/if}}
              >
                {{localize 'HELLPIERCERS.UI.party_vehicle.buy'}}
              </button>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    </div>
    <div class="panel">
      <textarea
        name="system.vehicle.notes"
        placeholder="{{localize 'HELLPIERCERS.UI.party_vehicle.vehicle_notes'}}"
      >{{system.vehicle.notes}}</textarea>
    </div>
  {{else}}
    <p class="hint">
      {{
        localize 'HELLPIERCERS.UI.party_vehicle.build_the_synthetic_spinther_manufacturing'
      }}
    </p>
  {{/if}}
</section>
