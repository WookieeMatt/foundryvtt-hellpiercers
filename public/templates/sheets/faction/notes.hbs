<section
  class="tab notes {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  {{#each editors}}
    <div class="panel">
      <h3>{{label}}</h3>
      {{#if @root.editable}}
        {{formInput field value=value enriched=enriched toggled=true}}
      {{else}}
        <div class="editor-content">{{{enriched}}}</div>
      {{/if}}
    </div>
  {{/each}}
  {{#if isGM}}
    <div class="panel adjustments">
      <h3>{{localize 'HELLPIERCERS.UI.faction_notes.quality_adjustments'}}</h3>
      <p class="hint">
        {{
          localize 'HELLPIERCERS.UI.faction_notes.qualities_are_the_sum_of_active_locations' startTotal=startTotal
        }}
      </p>
      <div class="row">
        {{#each adjust}}
          <label>{{key}} <input
              type="number"
              name="system.qualityAdjust.{{key}}"
              value="{{value}}"
            ></label>
        {{/each}}
        <label>{{localize 'HELLPIERCERS.UI.faction_notes.starting_total'}}
          <input
            type="number"
            name="system.startTotal"
            value="{{startTotal}}"
            min="0"
          ></label>
        <label>{{localize 'HELLPIERCERS.UI.faction_notes.crown_override'}}
          <input
            type="number"
            name="system.crown.override"
            value="{{crownOverride}}"
            min="1"
            max="5"
          ></label>
      </div>
    </div>
  {{/if}}
</section>
