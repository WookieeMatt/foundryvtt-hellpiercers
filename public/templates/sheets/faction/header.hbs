<header class="sheet-header stratcom-header faction-header">
  <img
    class="portrait"
    src="{{actor.img}}"
    data-edit="img"
    data-action="editImage"
    title="{{actor.name}}"
  >
  <div class="titles">
    <input
      type="text"
      name="name"
      value="{{actor.name}}"
      placeholder="{{localize 'HELLPIERCERS.UI.faction_header.faction'}}"
    >
    <input
      type="text"
      name="system.crown.description"
      value="{{system.crown.description}}"
      placeholder="{{localize 'HELLPIERCERS.UI.faction_header.crown'}}"
    >
    <input
      type="text"
      name="system.boss"
      value="{{system.boss}}"
      placeholder="{{localize 'HELLPIERCERS.UI.faction_header.boss'}}"
    >
  </div>
  <div
    class="crown"
    data-tooltip="Crown {{system.crown.value}} of {{system.crown.max}}"
  >
    <span class="label">{{
        localize 'HELLPIERCERS.UI.faction_header.crown'
      }}</span>
    {{#each crownPips}}
      <i class="fa-solid fa-crown {{#if filled}}filled{{else}}empty{{/if}}"></i>
    {{/each}}
  </div>
  <div class="qualities">
    {{#each qualities}}
      <div class="quality {{key}}">
        <a
          data-action="rollQuality"
          data-quality="{{key}}"
          data-tooltip="Roll {{label}} (shift: public)"
        >
          <i class="fa-solid fa-dice-d6"></i>
        </a>
        <span class="label">{{label}}</span>
        <span class="dots">
          {{#each dots}}<i
              class="fa-solid fa-circle {{#if filled}}filled{{else}}empty{{/if}}"
            ></i>{{/each}}
        </span>
        <b>{{value}}</b>{{#if (gt raw value)}}<small>(+{{raw}})</small>{{/if}}
      </div>
    {{/each}}
  </div>
  {{#if finalAssaultReady}}
    <div class="banner">
      {{
        localize 'HELLPIERCERS.UI.faction_header.final_assault_available_zero_at_0' zero=zero
      }}
    </div>
  {{/if}}
  {{#if isGM}}
    <div class="campaign-state">
      <span class="phase">{{localize 'HELLPIERCERS.UI.faction_header.phase'}} <b
        >{{phase}}</b></span>
      <span class="ichor"><i class="fa-solid fa-droplet"></i> {{
          localize 'HELLPIERCERS.UI.faction_header.ichor'
        }} <b>{{
            localize 'HELLPIERCERS.UI.faction_header.ichor_2' ichor=ichor
          }}</b></span>
    </div>
  {{/if}}
</header>
