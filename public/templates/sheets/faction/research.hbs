<section
  class="tab research {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  <div class="toolbar">
    <select name="project">
      {{#each projectChoices}}
        <option value="{{key}}" {{#if disabled}}disabled{{/if}}>
          {{
            localize 'HELLPIERCERS.UI.faction_research.name_cost_ichor_time_time' name=name cost=cost time=time
          }}
        </option>
      {{/each}}
    </select>
    <button
      type="button"
      data-action="startProject"
      {{#if atLimit}}disabled{{/if}}
    >
      <i class="fa-solid fa-flask"></i> {{
        localize 'HELLPIERCERS.UI.faction_research.start_project'
      }}
    </button>
    {{#if atLimit}}<span class="hint">{{
          localize 'HELLPIERCERS.UI.faction_research.two_projects_are_already_in_development'
        }}</span>{{/if}}
  </div>
  <ul class="projects">
    {{#each projects}}
      <li
        class="project {{#if complete}}complete{{/if}}"
        data-project-id="{{id}}"
      >
        <div class="row">
          <b>{{name}}</b>
          {{#if complete}}<span class="state"><i class="fa-solid fa-check"></i>
              {{
                localize 'HELLPIERCERS.UI.faction_research.complete'
              }}</span>{{/if}}
        </div>
        <p>{{effect}}</p>
        {{#unless complete}}
          <div class="row">
            {{localize 'HELLPIERCERS.UI.faction_research.ichor'}}
            <b>{{paid}}</b> / {{cost}}
            <button type="button" data-action="payProject" data-amount="1">
              +1
            </button>
            <button type="button" data-action="payProject" data-amount="all">
              {{localize 'HELLPIERCERS.UI.faction_research.pay_all'}}
            </button>
            &nbsp; {{localize 'HELLPIERCERS.UI.faction_research.research_time'}}
            {{#each boxes}}<i
                class="fa-solid fa-square {{#if filled}}filled{{else}}empty{{/if}}"
              ></i>{{/each}}
            <button
              type="button"
              data-action="tickProject"
              {{#unless canTick}}disabled{{/unless}}
            >
              {{localize 'HELLPIERCERS.UI.faction_research.fill_box'}}
            </button>
            <a
              data-action="scrapProject"
              data-tooltip="{{localize 'HELLPIERCERS.UI.faction_research.scrap_refund_half_of_the_ichor_paid'}}"
            >
              <i class="fa-solid fa-trash"></i>
            </a>
          </div>
        {{/unless}}
      </li>
    {{/each}}
  </ul>
</section>
