<section
  class="tab locations {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  <div class="toolbar">
    <button type="button" data-action="addLocation">
      <i class="fa-solid fa-plus"></i> {{
        localize 'HELLPIERCERS.UI.faction_locations.add_location'
      }}
    </button>
  </div>
  <ul class="locations">
    {{#each locations}}
      <li class="location {{status}}" data-location-id="{{id}}">
        <div class="row">
          <input
            type="text"
            data-array="location"
            data-id="{{id}}"
            data-field="name"
            value="{{name}}"
          >
          <select data-array="location" data-id="{{id}}" data-field="type">
            {{#each types}}<option
                value="{{key}}"
                {{#if selected}}selected{{/if}}
              >
                {{label}}
              </option>{{/each}}
          </select>
          <select data-array="location" data-id="{{id}}" data-field="status">
            {{#each statuses}}<option
                value="{{key}}"
                {{#if selected}}selected{{/if}}
              >
                {{label}}
              </option>{{/each}}
          </select>
          <a
            data-action="removeLocation"
            data-tooltip="{{localize 'HELLPIERCERS.UI.faction_locations.delete'}}"
          ><i class="fa-solid fa-trash"></i></a>
        </div>
        <div class="row quality">
          <span>{{localize 'HELLPIERCERS.UI.faction_locations.quality'}}</span>
          {{#each quality}}
            <label>
              {{@key}}
              <input
                type="number"
                min="0"
                data-array="location"
                data-id="{{../id}}"
                data-field="quality.{{@key}}"
                value="{{this}}"
              >
            </label>
          {{/each}}
          <label class="checkbox">
            <input
              type="checkbox"
              data-array="location"
              data-id="{{id}}"
              data-field="revealed"
              {{#if revealed}}checked{{/if}}
            >
            {{localize 'HELLPIERCERS.UI.faction_locations.known_to_players'}}
          </label>
        </div>
        {{#if building}}
          <div class="row build">
            {{localize 'HELLPIERCERS.UI.faction_locations.construction'}}
            <b>{{buildValue}}</b> / {{buildMax}}
            <button type="button" data-action="buildStep">
              {{localize 'HELLPIERCERS.UI.faction_locations.plus_one_phase'}}
            </button>
          </div>
        {{/if}}
        {{#if requires}}<p class="requires">
            {{
              localize 'HELLPIERCERS.UI.faction_locations.requires_requires' requires=requires
            }}
          </p>{{/if}}
      </li>
    {{/each}}
  </ul>
</section>
