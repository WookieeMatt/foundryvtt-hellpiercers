<section
  class="tab actions {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  <h3>{{localize 'HELLPIERCERS.UI.faction_actions.stratcom_actions'}}</h3>
  {{#unless actions.length}}
    <p class="hint">
      {{
        localize 'HELLPIERCERS.UI.faction_actions.this_faction_prints_no_stratcom_actions_up'
      }}
    </p>
  {{/unless}}
  <ul class="stratcom-actions">
    {{#each actions}}
      <li
        class="action {{#if locked}}locked{{/if}}"
        data-action-name="{{name}}"
      >
        <div class="row">
          <b>{{name}}</b>
          {{#if crown}}
            <span
              class="crown-gate"
              title="Crown gate: usable once the Crown has fallen to {{crown}}"
            >
              {{#each crownPips}}<i class="fa-solid fa-crown"></i>{{/each}}
              {{#if locked}}<i class="fa-solid fa-lock"></i>{{/if}}
            </span>
          {{/if}}
          {{#if @root.isGM}}
            <button type="button" data-action="useAction">
              <i class="fa-solid fa-bolt"></i> {{
                localize 'HELLPIERCERS.UI.faction_actions.use'
              }}
            </button>
          {{/if}}
        </div>
        {{#if flavor}}<p class="flavor"><em>{{flavor}}</em></p>{{/if}}
        <div class="body">{{{body}}}</div>
        {{#if hazard}}<p class="hint">
            {{
              localize 'HELLPIERCERS.UI.faction_actions.creates_hazard' name=hazard.name stages=hazard.stages
            }}
            {{#if hazard.auto}}
              {{
                localize 'HELLPIERCERS.UI.faction_actions.advances_each_phase'
              }}{{/if}}
          </p>{{/if}}
      </li>
    {{/each}}
  </ul>

  {{#if mechanics.length}}
    <h3>{{localize 'HELLPIERCERS.UI.faction_actions.unique_mechanics'}}</h3>
    <ul class="stratcom-actions">
      {{#each mechanics}}
        <li class="action" data-action-name="{{name}}">
          <b>{{name}}</b>
          {{#if flavor}}<p class="flavor"><em>{{flavor}}</em></p>{{/if}}
          <div class="body">{{{body}}}</div>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <div class="row hazards-head">
    <h3>{{localize 'HELLPIERCERS.UI.faction_actions.map_hazards'}}</h3>
    {{#if @root.isGM}}<button type="button" data-action="addHazard">
        <i class="fa-solid fa-plus"></i> {{
          localize 'HELLPIERCERS.UI.faction_actions.create_map_hazard'
        }}
      </button>{{/if}}
  </div>
  {{#unless hazards.length}}<p class="hint">
      {{localize 'HELLPIERCERS.UI.faction_actions.no_active_map_hazards'}}
    </p>{{/unless}}
  <ul class="hazards">
    {{#each hazards}}
      <li class="hazard" data-hazard="{{id}}">
        <div class="row">
          <b>{{name}}</b>
          {{#if location}}<span class="where">@ {{location}}</span>{{/if}}
          {{#if staged}}
            <span class="stage">
              {{#if @root.isGM}}<button
                  type="button"
                  data-action="stepHazard"
                  data-delta="-1"
                >
                  <i class="fa-solid fa-minus"></i>
                </button>{{/if}}
              {{
                localize 'HELLPIERCERS.UI.faction_actions.stage_of' stage=stage max=maxStage
              }}{{#if auto}}
                {{localize 'HELLPIERCERS.UI.faction_actions.auto'}}{{/if}}
              {{#if @root.isGM}}<button
                  type="button"
                  data-action="stepHazard"
                  data-delta="1"
                >
                  <i class="fa-solid fa-plus"></i>
                </button>{{/if}}
            </span>
          {{/if}}
          {{#if @root.isGM}}
            <button type="button" data-action="clearHazard">
              <i class="fa-solid fa-broom"></i> {{
                localize 'HELLPIERCERS.UI.faction_actions.clear'
              }}
            </button>
            <button type="button" data-action="removeHazard">
              <i class="fa-solid fa-trash"></i>
            </button>
          {{/if}}
        </div>
        {{#if intro}}<p class="hint">{{intro}}</p>{{/if}}
        {{#if text}}<div class="body">{{{text}}}</div>{{/if}}
        {{#if notes}}<p>{{notes}}</p>{{/if}}
      </li>
    {{/each}}
  </ul>
  {{#if clearedHazards.length}}
    <p class="hint">
      {{localize 'HELLPIERCERS.UI.faction_actions.cleared'}}
      {{#each clearedHazards}}{{this}}{{#unless @last}},
        {{/unless}}{{/each}}
    </p>
  {{/if}}
</section>
