<section
  class="tab convoys {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  <div class="toolbar">
    <button type="button" data-action="deployConvoy">
      <i class="fa-solid fa-truck-fast"></i> {{
        localize 'HELLPIERCERS.UI.faction_convoys.deploy_convoy'
      }}
    </button>
    <span class="hint">{{
        localize 'HELLPIERCERS.UI.faction_convoys.convoys_arrive_at_the_start_of_the_second' currentPhase=currentPhase
      }}</span>
  </div>
  <ul class="convoys">
    {{#each convoys}}
      <li class="convoy {{status}}" data-convoy-id="{{id}}">
        <div class="row">
          <b>{{kindLabel}}</b>
          <input
            type="text"
            data-array="convoy"
            data-id="{{id}}"
            data-field="name"
            value="{{name}}"
            placeholder="{{localize 'HELLPIERCERS.UI.faction_convoys.name'}}"
          >
          <span>{{from}} &rarr; {{to}}</span>
          <span class="status">{{statusLabel}}{{#if traveling}}
              {{
                localize 'HELLPIERCERS.UI.faction_convoys.arrives_phase_n' phase=arrivesPhase
              }}{{/if}}</span>
        </div>
        <div class="row">
          <input
            type="text"
            data-array="convoy"
            data-id="{{id}}"
            data-field="outcome"
            value="{{outcome}}"
            placeholder="{{localize 'HELLPIERCERS.UI.faction_convoys.outcome_on_arrival'}}"
            list="outcomes-{{id}}"
          >
          <datalist id="outcomes-{{id}}">
            {{#each outcomes}}<option value="{{this}}"></option>{{/each}}
          </datalist>
          <label class="checkbox">
            <input
              type="checkbox"
              data-array="convoy"
              data-id="{{id}}"
              data-field="revealed"
              {{#if revealed}}checked{{/if}}
            >
            {{localize 'HELLPIERCERS.UI.faction_convoys.revealed'}}
          </label>
          {{#if arrived}}
            <button
              type="button"
              data-action="resolveConvoy"
              data-status="resolved"
            >
              {{localize 'HELLPIERCERS.UI.faction_convoys.resolve'}}
            </button>
          {{/if}}
          {{#if traveling}}
            <button
              type="button"
              data-action="resolveConvoy"
              data-status="intercepted"
            >
              {{localize 'HELLPIERCERS.UI.faction_convoys.intercepted'}}
            </button>
          {{/if}}
          <a
            data-action="removeConvoy"
            data-tooltip="{{localize 'HELLPIERCERS.UI.faction_convoys.delete'}}"
          ><i class="fa-solid fa-trash"></i></a>
        </div>
      </li>
    {{/each}}
  </ul>
</section>
