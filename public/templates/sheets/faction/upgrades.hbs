<section
  class="tab upgrades {{tab.cssClass}} scrollable flexcol"
  data-tab="{{tab.id}}"
  data-group="primary"
>
  {{#if hasCatalog}}
    {{#if ichor}}<p class="hint">GM Ichor: <b>{{ichor}}</b></p>{{/if}}
    <ul class="upgrades">
      {{#each upgrades}}
        <li class="upgrade {{#if owned}}owned{{/if}}" data-upgrade="{{name}}">
          <div class="row">
            <b>{{name}}</b>
            <span class="cost">{{cost}} Ichor</span>
            {{#if owned}}
              <span class="state"><i class="fa-solid fa-check"></i>
                Unlocked</span>
            {{else}}
              <button type="button" data-action="buyUpgrade">Unlock</button>
            {{/if}}
          </div>
          {{#if effect}}<p>{{effect}}</p>{{/if}}
          {{#if requires}}<p class="requires">Requires: {{requires}}</p>{{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="hint">
      This faction has no catalog upgrades. Track custom upgrades in the War
      Journal.
    </p>
  {{/if}}
</section>
