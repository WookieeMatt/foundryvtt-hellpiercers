<ol class="combat-tracker plain">
  {{#each turns}}
    <li
      class="combatant {{ css }}"
      data-combatant-id="{{ id }}"
      data-action="activateCombatant"
      data-group-id="{{ groupId }}"
    >
      {{!-- TODO: Targets --}}

      {{!-- Image --}}
      <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

      {{!-- Name & Controls --}}
      <div class="token-name">
        <strong class="name">{{name}}{{#if groupId}}
            <i class="fa-solid fa-people-group"></i> ({{
              groupSize
            }}){{/if}}</strong>
        <div class="combatant-controls">
          {{#if @root.user.isGM}}
            <button
              type="button"
              class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
              data-action="toggleHidden"
              data-tooltip
              aria-label='{{ localize "COMBATANT.ToggleVis" }}'
            >
            </button>
            <button
              type="button"
              class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
              data-action="toggleDefeated"
              data-tooltip
              aria-label='{{ localize "COMBATANT.ToggleDead" }}'
            >
            </button>
          {{/if}}
          {{#if canPing}}
            <button
              type="button"
              class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
              data-action="pingCombatant"
              data-tooltip
              aria-label='{{ localize "COMBATANT.Ping" }}'
            >
            </button>
          {{/if}}
          {{#unless @root.user.isGM}}
            <button
              type="button"
              class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
              data-action="panToCombatant"
              data-tooltip
              aria-label='{{ localize "COMBATANT.PanTo" }}'
            >
            </button>
          {{/unless}}
          {{!-- TODO: Target Control --}}
          <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
            {{#each effects.icons}}
              <img class="token-effect" src="{{ img }}" alt="{{ name }}">
            {{/each}}
          </div>
        </div>
      </div>

      {{!-- Resource --}}
      {{#if resource includeZero=true}}
        <div class="token-resource">
          <span class="resource">{{resource}}</span>
        </div>
      {{/if}}

      {{!-- Initiative --}}
      <div class="token-initiative">
        {{#if pips}}
          <div class="action-pips">
            {{#each pips}}
              <span
                class="pip {{id}} {{#if spent}}spent{{/if}} {{#if blocked}}blocked{{/if}}"
              ></span>
            {{/each}}
          </div>
        {{/if}}
        {{#each buttons}}
          <button
            type="button"
            class="icon {{ icon }}"
            data-action="{{ action }}"
            data-tooltip
            aria-label='{{ localize (concat "HELLPIERCERS.COMBAT." action) }}'
          >
          </button>
        {{/each}}
      </div>
    </li>
  {{/each}}
</ol>
